
type Query {
  getPerson: Person
  getHabit(id: Int!): Habit
  getHabits: [Habit]
  getExecutions: [Execution]
  getDayStatuses: [DayStatus]
}

type Mutation {
  saveHabit(habitInput: HabitInput!): Boolean
  deleteHabit(id: Int!): Boolean
  completeExecution(id: Int!, date: String!): Boolean
  skipExecution(id: Int!, date: String!): Boolean
  resetExecution(id: Int!, date: String!): Boolean
  failExecution(id: Int!, date: String!): Boolean

  skipDay(date: String!, reason: String!): Boolean
  failDay(date: String!, reason: String): Boolean
  resetDay(date: String!): Boolean
}

input HabitInput {
  id: ID
  name: String!
  shortName: String!
}

type Person {
  id: ID!
  firstName: String
  lastName: String
}

type Habit {
  id: ID!
  name: String
  shortName: String
}

type Execution {
  id: ID!
  date: String
  habit: Habit
  status: String
}

type DayStatus {
  id: ID!
  date: String
  status: String
  reason: String
}
